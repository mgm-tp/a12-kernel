{
  "name": "@com.mgmtp.a12.kernel/kernel-md-facade",
  "version": "30.8.7",
  "description": "Model API",
  "scripts": {
    "build": "npm run clean && npm run compile && npm test",
    "lint": "npm run internal:eslint",
    "clean": "rimraf ./lib ./doc ./LINT-com.mgmtp.a12.kernel-*.xml ./build/npm_reports/TEST-com.mgmtp.a12.kernel-*.xml",
    "compile": "npm-run-all --parallel --max-parallel 2 internal:compile:**",
    "dev": "npm run compile",
    "test": "npm-run-all --parallel --max-parallel 2 internal:test:**",
    "doc": "npm run internal:doc:typedoc",
    "internal:compile:typescript": "tsc",
    "internal:test:mocha": "npm run internal:mocha -- --reporter xunit --reporter-options output=./build/npm_reports/TEST-com.mgmtp.a12.kernel-kernel-md-facade.xml",
    "internal:doc:typedoc": "typedoc --entryPointStrategy expand",
    "internal:eslint": "eslint \"./src/**/*.ts\" --ignore-pattern './src/typings/**/*' --max-warnings=0",
    "internal:mocha": "mocha --timeout 60000 --ui tdd --sort --recursive ./lib/test/js",
    "prepack": "node ../../scripts/prepack-clean.js",
    "postpack": "node ../../scripts/postpack-restore.js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./lib/main/js/index.js",
  "types": "./lib/main/js/index.d.ts",
  "exports": {
    ".": "./lib/main/js/index.js",
    "./a12internal": "./lib/main/js/a12internal/index.js",
    "./internal": "./lib/main/js/internal/index.js",
    "./lib/*": "./lib/*"
  },
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "dependencies": {
    "@com.mgmtp.a12.kernel/kernel-core-runtime-api-ts": "30.8.7",
    "@com.mgmtp.a12.kernel/kernel-core-runtime-ts": "30.8.7"
  },
  "devDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "^29.3.3",
    "@com.mgmtp.a12.devtools/tsconfig": "^1.1.0",
    "@com.mgmtp.a12.devtools/prettier-config": "^1.1.0",
    "@com.mgmtp.a12.kernel/kernel-eslint-config": "30.8.7",
    "@com.mgmtp.a12.utils/utils-collections": "^6.2.0",
    "@com.mgmtp.a12.utils/utils-localization": "^7.2.2",
    "@com.mgmtp.a12.utils/utils-logging": "^6.2.2",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@types/big.js": "^6.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.3",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.15",
    "typescript": ">=5.9.3 <6.0.0"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.base/base-model-api": "^29.3.1",
    "@com.mgmtp.a12.utils/utils-localization": "^7.2.0",
    "@com.mgmtp.a12.utils/utils-logging": "^6.2.0"
  },
  "files": [
    "lib/main",
    "modules",
    "src/main/js",
    "tsconfig.json",
    "cyclonedx.json"
  ]
}